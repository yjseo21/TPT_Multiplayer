# TPT Multiplayer room server as a systemd *user* service, sandboxed.
#
# One room per folder: tpt-server@NAME runs ~/services/powdertoy/NAME, which
# holds the server binary and its settings:
#
#   ~/services/powdertoy/NAME/tpt-server    the server
#   ~/services/powdertoy/NAME/server.env    TPT_ROOM_TOKEN=..., TPT_ADMIN_TOKEN=...,
#                                            TPT_PORT=34403 (one per line, chmod 600)
#   ~/services/powdertoy/NAME/data/          autosaves (the only place it may write)
#
# Install:
#   install -m 644 tpt-server@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now tpt-server@NAME
#   loginctl enable-linger "$USER"     (keeps it running when you are logged out)
#
# The server runs as you, so the sandbox does the work a separate user would:
# your home folder is replaced by an empty one with only this room's folder in
# it (read-only, except data/), so it cannot see your files, keys or other
# programs' settings. The rest of the system is read-only, it has no
# privileges, and it may use only internet sockets and the system calls an
# ordinary network service needs.

[Unit]
Description=TPT Multiplayer room %i

[Service]
Type=simple
EnvironmentFile=%h/services/powdertoy/%i/server.env
WorkingDirectory=%h/services/powdertoy/%i/data
ExecStart=%h/services/powdertoy/%i/tpt-server --port ${TPT_PORT} --autosave-dir %h/services/powdertoy/%i/data/autosaves --recover
Restart=on-failure
RestartSec=5
UMask=0077

# Files: an empty home with only this room in it; the binary is read-only, and
# the passwords file (already read by systemd) is hidden.
ProtectHome=tmpfs
BindReadOnlyPaths=%h/services/powdertoy/%i
BindPaths=%h/services/powdertoy/%i/data
InaccessiblePaths=%h/services/powdertoy/%i/server.env
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes

# A user namespace of its own: needed for the sandbox in a user service, and
# it leaves the server no privileges even inside it.
PrivateUsers=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes

# Kernel and the rest of the system: out of reach.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Only internet sockets, and only the system calls a network service needs.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# Bounded resources: a misbehaving room cannot starve this computer.
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
CPUQuota=200%

[Install]
WantedBy=default.target
