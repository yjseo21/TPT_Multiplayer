# TPT Multiplayer room server as a systemd *user* service.
#
# One room per folder: tpt-server@NAME runs ~/services/powdertoy/NAME, which
# holds the server binary and its settings:
#
#   ~/services/powdertoy/NAME/tpt-server    the server
#   ~/services/powdertoy/NAME/server.env    TPT_ROOM_TOKEN=..., TPT_ADMIN_TOKEN=...,
#                                            TPT_PORT=34403 (one per line, chmod 600)
#   ~/services/powdertoy/NAME/data/          autosaves
#
# Install:
#   install -m 644 tpt-server@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now tpt-server@NAME
#   loginctl enable-linger "$USER"     (keeps it running when you are logged out)
#
# Works on stock Ubuntu 24.04+ and other systems that restrict unprivileged
# user namespaces: it uses only restrictions a user service can apply without
# one. The server gets no privileges and cannot gain any, may use only
# internet sockets and the system calls an ordinary network service needs,
# cannot create namespaces or writable-and-executable memory, and has capped
# memory, tasks and CPU. It runs as you, though, so like any program you run it
# could read your files if it were compromised; HOSTING_SECURITY.md explains
# the trade-off and the system service that avoids it.

[Unit]
Description=TPT Multiplayer room %i

[Service]
Type=simple
EnvironmentFile=%h/services/powdertoy/%i/server.env
WorkingDirectory=%h/services/powdertoy/%i/data
ExecStart=%h/services/powdertoy/%i/tpt-server --port ${TPT_PORT} --autosave-dir %h/services/powdertoy/%i/data/autosaves --recover
Restart=on-failure
RestartSec=5
UMask=0077

# No privileges, ever (all enforced by system-call filters, no namespaces needed).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes

# Only internet sockets, and only the system calls a network service needs.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug
SystemCallErrorNumber=EPERM

# Bounded resources: a misbehaving room cannot starve this computer.
MemoryMax=2G
TasksMax=128
LimitNOFILE=1024
CPUQuota=200%

[Install]
WantedBy=default.target
